/* BASE STYLING */
QWidget {
    background-color: #222123;
    color: #FAECEE;
    font-family: "Cascadia Mono";
    font-size: 14px;
}

QWidget#view_bg {
    background-color: #222123;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    color: #000000;
    font-family: "Cascadia Mono";
    font-size: 14px;
}

QWidget#transparent {
    background-color: transparent;
}

/* TAB WIDGET */
QTabWidget::pane {
    border: 1px solid #732424;
    top: -1px;
}

QTabWidget QStackedWidget {
    background-color: #742424;
}

QTabBar{
    background-color: transparent;
}

QTabBar::tab {
    background-color: #654F56;
    color: #000000;
    border: 1px solid #9D1414;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    padding: 8px 16px;
    margin: 0px;
    width: 120px;
}

QTabWidget#subtabs QTabBar::tab {
    background-color: #654F56;
    width: 120px;
}

QTabWidget#subtabs QTabBar::tab:selected {
    background-color: #8C181F;
    width: 120px;
}

QTabBar::tab:selected {
    background-color: #8C181F;
    color: #ffffff;
    border-color: #E94650;
    font-weight: bold;
    width: 120px;
}

QTabBar::tab:!selected {
    border-bottom: 1px solid #9D1414;
    width: 120px;
}

QTabBar::tab:hover {
    background-color: #8C181F;
    color: #ffffff;
    border: 1px solid #FFFFFF;
    width: 120px;
}

QTabBar::tab:selected:hover {
    border-bottom: 1px solid #FFFFFF;
    width: 120px;
}

/* BUTTON STYLING */
QPushButton:!hover {
    background-color: #414242;
    color: #FAECEE;
    border: 1px solid #732424;
    border-radius: 5px;
    padding: 6px 12px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #8C181F;
    color: #FFFFFF;
    border: 1px solid #FFFFFF;
    margin: 1px 1px;
    padding: 5px 11px;
    border-radius: 5px;
    font-weight: bold;
}

QPushButton:pressed {
    margin: 3px 3px;
    padding 3px 9px;
    background-color: #F29796;
}

QPushButton#red_btn {
    background-color: #691601;
}

QPushButton#red_btn:pressed {
    background-color: #F29796;
}

QPushButton#green_btn {
    background-color: #FFC7D0;
    color: #D989A4;
}

QPushButton#green_btn:pressed {
    background-color: #F29796;
    color: #FFFFFF;
}

QPushButton#LOCKED {
    background-color: #A1A1A1;
}

/* LABEL STYLING */
QLabel {
    background-color: transparent;
    font-size: 15px;
    font-weight: bold;
}

QLabel#post_title {
    background-color: transparent;
    font-size: 18px;
    font-weight: bold;
}

/* DROP DOWN MENU STYLING */
QTabWidget QStackedWidget QComboBox {
    background-color: #544F50;
    color: #FAECEE;
    border: 0px;
    border-radius: 3px;
    padding: 4px 8px;
    min-width: 120px;
}

QComboBox QAbstractItemView {
    background-color: transparent;
    color: #000000;
    padding: 0px;
    min-width: 120px;
    font-size: 18px;
}

QComboBox QAbstractItemView:item {
    background-color: #414242;
    color: #FFFFFF;
    border-top: 1px solid #732424;
    margin: 0px;
    padding: 4px;
    min-width: 120px;
    font-size: 18px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #8C181F;
    color: #FFFFFF;
    border: 0px;
    min-width: 120px;
    font-size: 18px;
}

QComboBox#READ_ONLY,
QComboBox#LOCKED {
    background-color: #B0B0B0;
    color: #000000;
}

QComboBox::drop-down#READ_ONLY,
QComboBox::drop-down#LOCKED{
     background-color: 414242;
     color: #000000;
}

QComboBox:hover {
    background-color: #8C181F;
    color: #FFFFFF
}

QComboBox::drop-down {
    background-color: #C8252E;
    border-bottom-right-radius: 2px;
    border-top-right-radius: 2px;
    width: 20px;
    padding: 0;
}

QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 5px solid #414242;
    width: 0px;
    height: 0px;
}

/* Program Name Styling */
QLabel#program_name {
    font-size: 20px;
    font-weight: bold;
    color: #000000;
}

QLabel#revision_label {
    font-size: 12px;
    color: #666666;
    font-style: italic;
}

QWidget QStackedWidget QLineEdit {
    background-color: #414242;
    border: 1px solid #732424;
    border-radius: 3px;
    padding: 4px 8px;
}

QTabWidget QStackedWidget QlineEdit:hover,
QTabWidget QStackedWidget QLineEdit:focus {
    background-color: #8C181F;
}

QWidget QLineEdit#READ_ONLY,
QWidget QLineEdit#LOCKED {
    background-color: #B39699;
    color: #000000;
    border: 1px solid #732424;
    border-radius: 3px;
    padding: 4px 8px;
}

/* Horizontal Rule Style */
QLabel#hr {
    background-color: #5C4033;
    min-height: 1px;
    max-height: 1px;
    padding: 0px;
    margin: 0px;
}

/* Large button style */
QPushButton#large_btn {
    max-height: 76px;
    max-width: 129px;
    min-height: 76px;
    min-width: 129px;
    padding: 12px 20px;
    font-size: 14px;
    font-weight: bold;
}

/* Large button style */
QWidget QPushButton#crit_large_btn {
    background-color: #691601;
    max-height: 64px;
    max-width: 129px;
    min-height: 64px;
    min-width: 129px;
    padding: 12px 20px;
    font-size: 14px;
    font-weight: bold;
}

/* Status Section */
QWidget#status_container {
    background-color: #742424;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

QWidget#status_container::error {
    background-color: #691601;
    border: 1px solid #000000;
}

/* login screen styles */
LoginScreen {
    background-color: #B88E6D;
    color: #000000;
    font-family: "Cascadia Mono";
    font-size: 16px;
}

LoginScreen QLabel {
    background-color: transparent;
    color: #000000;
    font-size: 16px;
    font-weight: bold;
}

LoginScreen QLabel#login_title {
    font-size: 20px;
    font-weight: bold;
    color: #000000;
}

LoginScreen QLabel#rev_label {
    font-size: 12px;
    color: #5C4033;
    font-style: italic;
}


/* forgot_pw screen styles */
ForgotPasswordScreen {
    background-color: #B88E6D;
    color: #000000;
    font-family: "Cascadia Mono";
    font-size: 14px;
}

ForgotPasswordScreen QLabel {
    background-color: transparent;
    color: #000000;
    font-size: 14px;
    font-weight: bold;
}

ForgotPasswordScreen QLabel#title {
    font-size: 20px;
    font-weight: bold;
    color: #000000;
}

ForgotPasswordScreen QLabel#label {
    background-color: transparent;
    color: #000000;
    font-size: 16px;
    font-weight: bold;
}

ForgotPasswordScreen QLineEdit#response_field {
    background-color: #E5C59B;
    color: #000000;
    font-size: 16px;
    font-weight: normal;
}

ForgotPasswordScreen QComboBox {
    background-color: #5C4033;
    color: #ffffff;
    font-size: 16px;
    font-weight: bold;
}

ForgotPasswordScreen QComboBox::item {
    background-color: #5C4033;
    color: #ffffff;
    font-size: 16px;
    font-weight: bold;
}

ForgotPasswordScreen QComboBox QAbstractItemView {
    background-color: #5C4033;
    font-size: 16px;
}

ForgotPasswordScreen QComboBox QAbstractItemView::item {
    background-color: #5C4033;
    color: #ffffff;
    font-size: 16px;
    font-weight: bold;
    padding: 5px;
}

ForgotPasswordScreen QComboBox QAbstractItemView::item:hover {
    background-color: #E5C59B;
    color: #000000;
}

ForgotPasswordScreen QComboBox QAbstractItemView::item:selected {
    background-color: #E5C59B;
    color: #000000;
}

/*Entry QSS : admin_settings->rates*/
QWidget#entry_body {
    background-color: #242121;
    border: 2px solid #521B22;
    border-radius: 4px;
}

QLineEdit#entry_field {
    background-color: #8C181F;
    border: 1px solid #1F1A17;
    color: #1F1A17;
    border-radius: 3px;
    padding: 4px 8px;
}

QLineEdit#entry_field[state="READ_ONLY"] {
    background-color: #8C181F;
    color: #1F1A17;
}

/*Default entry Style: all entry field objects fall back to here for missing properties/invalid states*/
QLineEdit#entry_field{
    background-color: #8C181F;
    color: #FFFFFF;
    border: 1px solid #5C4033;
    border-radius: 3px;
    padding: 4px 8px;
}

/*State 01: Read-Only -> we change the background of the field and then fall back to the default style for the rest*/
QLineEdit#entry_field[state="READ_ONLY"] {
    background-color: #B39699;
}

/* Radio Button Colors */
QRadioButton::indicator {
    border: 2px solid #000000;
    border-radius: 7px;
    width: 12px;
    height: 12px;
}

QRadioButton::indicator:checked {
    background-color: #000000;
    border-radius: 7px;
}