/* BASE STYLING */
QWidget {
    background-color: #E7D9B7;
    color: #1F1A17;
    font-family: "Cascadia Mono";
    font-size: 14px;
}

QWidget#view_bg {
    background-color: #CDBB8C;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    color: #1F1A17;
    font-family: "Cascadia Mono";
    font-size: 14px;
}

QWidget#transparent {
    background-color: transparent;
}

/* TAB WIDGET */
QTabBar {
    background-color: transparent;
}

QTabWidget::pane {
    background-color: #CDBB8C;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    border-top-right-radius: 4px;
    border: 0px;
    top: -1px;
}

QTabWidget QStackedWidget {
    background-color: transparent;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    border-top-right-radius: 4px;
    border: 4px inset #043927;
}

QTabWidget QStackedWidget QWidget {
    background-color: transparent;
    border: 0px solid transparent;
}

QTabBar::tab {
    background-color: #043927;
    color: #FFFFFF;
    border: 1px solid transparent;
    padding: 12px 18px;
    margin: 0px;
    top: 6px;
    width: 120px;
}

QTabBar::tab:first {
    border-top-left-radius: 4px;
}

QTabBar::tab:last {
    border-top-right-radius: 4px;
}

QTabWidget#subtabs QTabBar::tab {
    background-color: #7A1F1F;
}

QTabWidget#subtabs QTabBar::tab:selected {
    background-color: #0B5D3B;
}

QTabWidget#subtabs::pane {
    background-color: #CDBB8C;
}

QTabBar::tab:selected {
    background-color: #0B5D3B;
    color: #FFFFFF;
    border: 0px;
    font-weight: bold;
    padding: 12px 48px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    top: 0px;
}

QTabBar::tab:hover {
    background-color: #0B5D3B;
    color: #FFFFFF;
    border: 1px solid #FFFFFF;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    font-weight: bold;
    top: 3px;
}

QTabBar::tab:selected:hover {
    border: 0px;
    top: 0px;
}

/* BUTTON STYLING */
QPushButton:!hover {
    background-color: #043927;
    color: #FFFFFF;
    border-radius: 5px;
    padding: 6px 12px;
    margin: 0px 0px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #0B5D3B;
    color: #FFFFFF;
    border: 1px solid #FFFFFF;
    margin: 1px 1px;
    padding: 5px 11px;
    border-radius: 5px;
    font-weight: bold;
}

QPushButton:pressed {
    margin: 3px 3px;
    padding: 3px 9px;
    background-color: #F6EFD8;
    color: #1F1A17;
}

QPushButton#red_btn {
    background-color: #7A1F1F;
    color: #FFFFFF;
}

QPushButton#red_btn:pressed {
    background-color: #F6EFD8;
    color: #1F1A17;
}

QTabWidget#subtabs QWidget QScrollArea {
    border-radius: 4px;
    background: #B8B1A3;
}

QTabWidget#subtabs QWidget QScrollArea > QWidget {
    background: #043927;
}

QTabWidget QWidget#search_tickets_tab QScrollArea {
    border-radius: 4px;
    background: #B8B1A3;
}

QTabWidget QWidget#search_tickets_tab QScrollArea > QWidget {
    background: #043927;
}

QTabWidget QWidget#vendor_tickets_tab QScrollArea {
    border-radius: 4px;
    background: #B8B1A3;
}

QTabWidget QWidget#vendor_tickets_tab QScrollArea > QWidget {
    background: #043927;
}

/* LABEL STYLING */
QLabel {
    background-color: transparent;
    font-size: 15px;
    font-weight: bold;
}

QLabel#post_title {
    background-color: transparent;
    font-size: 18px;
    font-weight: bold;
}

/* DROP DOWN MENU STYLING */
QTabWidget QStackedWidget QComboBox {
    background-color: #F6EFD8;
    color: #1F1A17;
    border: 0px;
    border-radius: 3px;
    padding: 4px 8px;
    min-width: 120px;
}

QComboBox QAbstractItemView {
    background-color: #F6EFD8;
    color: #1F1A17;
    padding: 0px;
    min-width: 120px;
    font-size: 18px;
}

QComboBox QAbstractItemView:item {
    background-color: #F6EFD8;
    color: #1F1A17;
    border-top: 1px solid #043927;
    margin: 0px;
    padding: 4px;
    min-width: 120px;
    font-size: 18px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #0B5D3B;
    color: #FFFFFF;
    border: 0px;
    min-width: 120px;
    font-size: 18px;
}

QComboBox#READ_ONLY,
QComboBox#LOCKED {
    background-color: #B8B1A3;
    color: #1F1A17;
}

QComboBox::drop-down#READ_ONLY,
QComboBox::drop-down#LOCKED {
    background-color: #4A3B2C;
}

QComboBox:hover {
    background-color: #CDBB8C;
    color: #1F1A17;
}

QComboBox::drop-down {
    background-color: #043927;
    border-bottom-right-radius: 2px;
    border-top-right-radius: 2px;
    width: 20px;
    padding: 0px;
}

QComboBox::drop-down:hover {
    background-color: #0B5D3B;
}

QComboBox::down-arrow:hover {
    image: none;
    border-top: 2px solid #FFFFFF;
}

QComboBox::down-arrow {
    image: none;
    border-left: 2px solid transparent;
    border-right: 2px solid transparent;
    border-top: 2px solid #F6EFD8;
    width: 0px;
    height: 0px;
}

/* Program Name Styling */
QLabel#program_name {
    font-size: 20px;
    font-weight: bold;
    color: #1F1A17;
}

QLabel#revision_label {
    font-size: 12px;
    color: #4A3B2C;
    font-style: italic;
}

QTabWidget QStackedWidget QLineEdit {
    background-color: #F6EFD8;
    border: 0px;
    color: #1F1A17;
    border-radius: 3px;
    padding: 4px 8px;
}

QTabWidget QStackedWidget QLineEdit:hover,
QTabWidget QStackedWidget QLineEdit:focus {
    background-color: #CDBB8C;
}

QWidget QLineEdit#READ_ONLY {
    background-color: #B8B1A3;
    color: #1F1A17;
}

/* Large button style */
QPushButton#large_btn {
    max-height: 76px;
    max-width: 129px;
    min-height: 76px;
    min-width: 129px;
    padding: 12px 20px;
    font-size: 14px;
    font-weight: bold;
}

/* Large button style */
QWidget QPushButton#crit_large_btn {
    background-color: #7A1F1F;
    color: #FFFFFF;
    max-height: 64px;
    max-width: 129px;
    min-height: 64px;
    min-width: 129px;
    padding: 12px 20px;
    font-size: 14px;
    font-weight: bold;
}

/* Status Section */
QWidget#status_container {
    background-color: #CDBB8C;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

/*Entry QSS : admin_settings->rates*/
QWidget#entry_body {
    background-color: #CDBB8C;
    border: 3px solid #CDBB8C;
    border-radius: 4px;
}

QWidget#entry_body:hover,
QWidget#entry_body[state="READ_WRITE"] {
    background-color: #0B5D3B;
    border: 3px solid transparent;
}

QLineEdit#entry_field {
    background-color: #F6EFD8;
    border: 1px solid #1F1A17;
    color: #1F1A17;
    border-radius: 3px;
    padding: 4px 8px;
}

QLineEdit#entry_field[state="READ_ONLY"] {
    background-color: #B8B1A3;
    color: #1F1A17;
}

/* Radio Button Colors */
QRadioButton::indicator {
    border: 2px solid #1F1A17;
    border-radius: 7px;
    width: 12px;
    height: 12px;
}

QRadioButton::indicator:checked {
    background-color: #043927;
    border-radius: 7px;
}